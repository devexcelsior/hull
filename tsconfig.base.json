{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"inlineSourceMap": false,
		"moduleResolution": "Node16",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": false,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"useDefineForClassFields": false,
		"types": ["node"],
		"paths": {
			"@mariozechner/pi-ai": ["../keel/packages/ai/dist/index.d.ts"],
			"@mariozechner/pi-ai/oauth": ["../keel/packages/ai/dist/oauth.d.ts"],
			"@mariozechner/pi-ai/bedrock-provider": ["../keel/packages/ai/dist/bedrock-provider.d.ts"],
			"@mariozechner/pi-ai/*": ["../keel/packages/ai/dist/*"],
			"@mariozechner/pi-agent-core": ["../keel/packages/agent/dist/index.d.ts"],
			"@mariozechner/pi-agent-core/*": ["../keel/packages/agent/dist/*"]
		}
	}
}
