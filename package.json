{
	"name": "hull",
	"private": true,
	"type": "module",
	"license": "MIT",
	"version": "0.1.0",
	"workspaces": [
		"packages/*",
		"packages/web-ui/example",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/tui && npm run build && cd ../coding-agent && npm run build && cd ../web-ui && npm run build",
		"dev": "concurrently --names \"coding-agent,web-ui,tui\" --prefix-colors \"red,green,magenta\" \"cd packages/coding-agent && npm run dev\" \"cd packages/web-ui && npm run dev\" \"cd packages/tui && npm run dev\"",
		"dev:tsc": "concurrently --names \"web-ui\" --prefix-colors \"green\" \"cd packages/web-ui && npm run dev:tsc\"",
		"check": "biome check --write --error-on-warnings . && tsc --noEmit",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "^22.10.5",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"concurrently": "^9.2.1",
		"tsx": "^4.20.3",
		"typescript": "^5.9.2"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@mariozechner/jiti": "^2.6.5",
		"@mariozechner/pi-coding-agent": "^0.72.0",
		"get-east-asian-width": "^1.4.0"
	},
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}