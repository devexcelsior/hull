# --- pi workflow state (per-worktree, never commit) ---
.pi/active.md
.pi_config/

# --- Orchestration logs (generated per pi-orchestrate run) ---
logs/

# --- Calibration artifacts (generated per step: traces, verify outputs) ---
docs/calibration/

# --- Roadmaps (working artifacts — ADRs are the durable output) ---
docs/roadmap/

# --- Node.js / TypeScript ---
node_modules/
**/node_modules/
dist/
build/
out/
*.tsbuildinfo
packages/*/dist/
packages/*/dist-chrome/
packages/*/dist-firefox/

# --- Environment & secrets ---
.env
.env.local
.env.*.local

# --- OS & editor droppings ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.zed/
.idea/

# --- Coverage & cache ---
coverage/
.cache/
.turbo/
.npm/
.nyc_output/

# --- General logs ---
*.log
tui-debug.log

